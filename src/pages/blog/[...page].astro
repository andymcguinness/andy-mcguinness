---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Analytics from '@vercel/analytics/astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import "../../styles/global.css";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

type Props = {
	page: Page<CollectionEntry<'blog'>>;
};

const { page } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog | ${SITE_TITLE}`}
			description="Thoughts, insights, and stories from Andy McGuinness - covering web development, streaming, music, and creative projects."
		/>
		<script is:inline>
			// Prevent flash of wrong theme
			(function() {
				const getTheme = () => {
					const stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') return stored;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				document.documentElement.classList.add(getTheme());
			})();
		</script>
	</head>
	<body class="bg-white dark:bg-black text-black dark:text-white">
		<Navigation currentPath="/blog" />

		<main class="pt-32 pb-20 px-6 sm:px-8 lg:px-12">
			<div class="max-w-4xl mx-auto">
				<!-- Page Header -->
				<div class="mb-20">
					<h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tighter mb-6">
						Blog
					</h1>
					<div class="w-24 h-1 bg-[#E8B4B8]"></div>
				</div>

				<!-- Timeline -->
				<div class="relative">
					<!-- Timeline line -->
					<div class="absolute left-0 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-800"></div>

					<!-- Posts -->
					<div class="space-y-16">
						{
							page.data.map((post, index) => {
								const postDate = new Date(post.data.pubDate);
								const formattedYear = postDate.getFullYear();
								const formattedMonth = postDate.toLocaleDateString('en-US', { month: 'short' });
								const formattedDay = postDate.getDate();

								return (
									<article class="relative pl-12 group fade-in" style={`animation-delay: ${index * 0.1}s`}>
										{/* Timeline marker */}
										<div class="absolute left-0 top-2 w-3 h-3 bg-[#E8B4B8] rounded-full transform -translate-x-[5px] group-hover:scale-150 transition-transform"></div>

										{/* Date */}
										<div class="flex items-baseline gap-3 mb-3">
											<time class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
												{formattedMonth} {formattedDay}, {formattedYear}
											</time>
										</div>

										{/* Post content */}
										<div>
											<h2 class="text-3xl sm:text-4xl font-bold mb-4 leading-tight">
												<a
													href={`/blog/${post.id}/`}
													class="hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
												>
													{post.data.title}
												</a>
											</h2>

											{post.data.description && (
												<p class="text-lg text-gray-600 dark:text-gray-400 mb-4 leading-relaxed">
													{post.data.description}
												</p>
											)}

											<a
												href={`/blog/${post.id}/`}
												class="inline-flex items-center text-base font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
											>
												Read post
												<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
												</svg>
											</a>
										</div>
									</article>
								)
							})
						}
					</div>
				</div>

				<!-- Pagination -->
				{(page.lastPage > 1) && (
					<div class="mt-20 pt-12 border-t border-gray-200 dark:border-gray-800">
						<div class="flex items-center justify-between">
							<div>
								{page.url.prev ? (
									<a
										href={page.url.prev}
										class="inline-flex items-center text-lg font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
									>
										<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
										</svg>
										Previous
									</a>
								) : (
									<span class="text-gray-400 dark:text-gray-600">Previous</span>
								)}
							</div>

							<div class="text-sm text-gray-500 dark:text-gray-400">
								Page {page.currentPage} of {page.lastPage}
							</div>

							<div>
								{page.url.next ? (
									<a
										href={page.url.next}
										class="inline-flex items-center text-lg font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
									>
										Next
										<svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
										</svg>
									</a>
								) : (
									<span class="text-gray-400 dark:text-gray-600">Next</span>
								)}
							</div>
						</div>
					</div>
				)}
			</div>
		</main>

		<Footer />
		<Analytics />
	</body>
</html>
