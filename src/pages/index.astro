---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Analytics from '@vercel/analytics/astro'
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline>
			// Prevent flash of wrong theme
			(function() {
				const getTheme = () => {
					const stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') return stored;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				document.documentElement.classList.add(getTheme());
			})();
		</script>
	</head>
	<body class="bg-white dark:bg-black text-black dark:text-white">
		<!-- Hero Section - Minimalist Statement -->
		<main class="min-h-screen flex flex-col">
			<!-- Main Hero -->
			<section class="flex-1 flex items-center justify-center px-6 sm:px-8 lg:px-12">
				<div class="max-w-6xl w-full">
					<div class="fade-in">
						<h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter mb-6 sm:mb-8">
							Andy<br/>McGuinness
						</h1>
						<div class="w-24 h-1 bg-[#8FC9E8] mb-8 sm:mb-12"></div>
						<p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-light text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed">
							IT support specialist with 6+ years of hands-on troubleshooting, now studying for the CompTIA A+.
						</p>
						<div class="mt-12 sm:mt-16 flex flex-wrap gap-6 sm:gap-8">
							<a
								href="/about"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#8FC9E8] hover:border-[#5FA8D3] transition-colors pb-1"
							>
								About
							</a>
							<a
								href="/resume"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#8FC9E8] hover:border-[#5FA8D3] transition-colors pb-1"
							>
								Resume
							</a>
							<a
								href="/blog"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#8FC9E8] hover:border-[#5FA8D3] transition-colors pb-1"
							>
								Blog
							</a>
							<a
								href="/contact"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#8FC9E8] hover:border-[#5FA8D3] transition-colors pb-1"
							>
								Contact
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Scroll Indicator -->
			<div class="pb-12 flex justify-center">
				<div class="animate-bounce">
					<svg class="w-6 h-6 text-[#8FC9E8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</div>
			</div>
		</main>

		<Footer />
		<Analytics />
	</body>
</html>
