---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Analytics from '@vercel/analytics/astro'
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline>
			// Prevent flash of wrong theme
			(function() {
				const getTheme = () => {
					const stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') return stored;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				document.documentElement.classList.add(getTheme());
			})();
		</script>
	</head>
	<body class="bg-white dark:bg-black text-black dark:text-white">
		<!-- Hero Section - Minimalist Statement -->
		<main class="min-h-screen flex flex-col">
			<!-- Main Hero -->
			<section class="flex-1 flex items-center justify-center px-6 sm:px-8 lg:px-12">
				<div class="max-w-6xl w-full">
					<div class="fade-in">
						<h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-black leading-none tracking-tighter mb-6 sm:mb-8">
							Andy<br/>McGuinness
						</h1>
						<div class="w-24 h-1 bg-[#E8B4B8] mb-8 sm:mb-12"></div>
						<p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-light text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed">
							Support expert with engineering experience. I speak both tech and human.
						</p>
						<div class="mt-12 sm:mt-16 flex flex-wrap gap-6 sm:gap-8">
							<a
								href="/about"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
							>
								About
							</a>
							<a
								href="/resume"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
							>
								Resume
							</a>
							<a
								href="/blog"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
							>
								Blog
							</a>
							<a
								href="/contact"
								class="text-lg sm:text-xl font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
							>
								Contact
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Scroll Indicator -->
			<div class="pb-12 flex justify-center">
				<div class="animate-bounce">
					<svg class="w-6 h-6 text-[#E8B4B8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</div>
			</div>
		</main>

		<!-- Featured Section -->
		<section class="px-6 sm:px-8 lg:px-12 py-20 sm:py-32 bg-gray-50 dark:bg-gray-900">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-12 sm:mb-16 tracking-tight">
					Featured Projects
				</h2>

				<!-- Featured Content Grid -->
				<div class="grid md:grid-cols-2 gap-12 lg:gap-16">
					<!-- Genre Ipsum -->
					<div class="group">
						<div class="mb-4">
							<span class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Side Project</span>
						</div>
						<h3 class="text-3xl sm:text-4xl font-bold mb-4 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
							Genre Ipsum
						</h3>
						<p class="text-lg text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
							A fun twist on the classic Lorem Ipsum generator — placeholder text with personality, themed by genre.
						</p>
						<a
							href="https://genreipsum.com"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center text-lg font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
						>
							Check it out
							<svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>

					<!-- Freelance Business -->
					<div class="group">
						<div class="mb-4">
							<span class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Freelance Development</span>
						</div>
						<h3 class="text-3xl sm:text-4xl font-bold mb-4 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
							Code by Andy
						</h3>
						<p class="text-lg text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
							Building thoughtful web development projects for values-based small business owners.
						</p>
						<a
							href="https://codebyandy.com"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center text-lg font-medium border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors pb-1"
						>
							Work together
							<svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>

		<Footer />
		<Analytics />
	</body>
</html>
