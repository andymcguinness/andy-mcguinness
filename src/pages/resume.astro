---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Analytics from '@vercel/analytics/astro'
import "../styles/global.css";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title=`Resume | ${SITE_TITLE}` description="Andy McGuinness's professional resume — IT support specialist with 6+ years of hands-on technical troubleshooting experience, studying for the CompTIA A+." />
		<script is:inline>
			// Prevent flash of wrong theme
			(function() {
				const getTheme = () => {
					const stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') return stored;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				document.documentElement.classList.add(getTheme());
			})();
		</script>
	</head>
	<body class="bg-white dark:bg-black text-black dark:text-white">
		<Navigation currentPath="/resume" />

		<main class="pt-32 pb-20 px-6 sm:px-8 lg:px-12">
			<div class="max-w-4xl mx-auto">
				<!-- Page Header -->
				<div class="mb-20">
					<h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tighter mb-6">
						Resume
					</h1>
					<div class="w-24 h-1 bg-[#8FC9E8] mb-12"></div>
					<p class="text-2xl sm:text-3xl font-light text-gray-600 dark:text-gray-400 leading-relaxed max-w-3xl mb-6">
						IT Support Specialist
					</p>
					<p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-3xl">
						IT professional with 6+ years of hands-on experience troubleshooting production systems and resolving technical incidents, now pivoting into IT support. Served as the front-line point of contact for technical issues affecting hundreds of thousands of customers, leading root-cause investigations and triaging by business urgency. Experienced in root-cause analysis and in explaining technical issues clearly to non-technical teams. Currently studying for the CompTIA A+ certification.
					</p>
				</div>

				<!-- Skills -->
				<section class="mb-16">
					<h2 class="text-3xl sm:text-4xl font-bold mb-8 tracking-tight">Skills</h2>
					<div class="space-y-6">
						<div>
							<h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Hardware & Devices</h3>
							<div class="flex flex-wrap gap-3">
								{['PC Building & Repair', 'Hardware Diagnostics', 'Mobile Devices', 'Printers & Peripherals'].map((skill) => (
									<span class="px-4 py-2 border border-gray-200 dark:border-gray-800 text-sm font-medium">{skill}</span>
								))}
							</div>
						</div>
						<div>
							<h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Operating Systems</h3>
							<div class="flex flex-wrap gap-3">
								{['Windows 10/11', 'macOS', 'Linux Fundamentals', 'Virtualization'].map((skill) => (
									<span class="px-4 py-2 border border-gray-200 dark:border-gray-800 text-sm font-medium">{skill}</span>
								))}
							</div>
						</div>
						<div>
							<h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Networking & Security</h3>
							<div class="flex flex-wrap gap-3">
								{['TCP/IP, DNS & DHCP', 'Wi-Fi & Network Troubleshooting', 'VPN & Remote Access', 'Security Fundamentals'].map((skill) => (
									<span class="px-4 py-2 border border-gray-200 dark:border-gray-800 text-sm font-medium">{skill}</span>
								))}
							</div>
						</div>
						<div>
							<h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Support & Tools</h3>
							<div class="flex flex-wrap gap-3">
								{['Active Directory', 'Remote Desktop & Ticketing Tools', 'Technical Documentation & SOPs', 'Customer Service', 'Incident Triage & Root-Cause Analysis'].map((skill) => (
									<span class="px-4 py-2 border border-gray-200 dark:border-gray-800 text-sm font-medium">{skill}</span>
								))}
							</div>
						</div>
					</div>
				</section>

				<!-- Work Experience -->
				<section class="mb-16 pt-12 border-t-2 border-gray-200 dark:border-gray-800">
					<h2 class="text-3xl sm:text-4xl font-bold mb-12 tracking-tight">Professional Experience</h2>

					<div class="space-y-16">
						<!-- Freelance Developer -->
						<div>
							<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
								<h3 class="text-xl font-bold">Code by Andy, LLC · Remote</h3>
								<span class="text-sm text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">July 2025 – Present</span>
							</div>
							<p class="text-[#8FC9E8] font-medium mb-4">Freelance IT Support & Systems Consultant</p>
							<ul class="list-disc list-outside ml-5 space-y-2 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
								<li>Provide technical support and systems troubleshooting for startup clients, including database configuration.</li>
								<li>Diagnose and resolve technical incidents, manage user access controls, and maintain documentation for ongoing support engagements.</li>
							</ul>
						</div>

						<!-- Software Engineer III -->
						<div>
							<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
								<h3 class="text-xl font-bold">Solera | AutoPoint · Remote</h3>
								<span class="text-sm text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">September 2023 – July 2025</span>
							</div>
							<p class="text-[#8FC9E8] font-medium mb-4">Software Engineer III</p>
							<ul class="list-disc list-outside ml-5 space-y-2 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
								<li>Served as a technical point of contact resolving system incidents affecting dashboards and reporting tools used by internal stakeholders.</li>
								<li>Diagnosed and resolved production system issues under support SLAs, minimizing downtime for business-critical tools.</li>
								<li>Documented troubleshooting procedures and provided technical guidance to support and business teams.</li>
								<li>Maintained and supported the systems and databases underlying customer-facing applications with millions of records.</li>
							</ul>
						</div>

						<!-- Lead Technical Operations Engineer -->
						<div>
							<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
								<h3 class="text-xl font-bold">Solera | AutoPoint · Jacksonville, FL</h3>
								<span class="text-sm text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">January 2022 – September 2023</span>
							</div>
							<p class="text-[#8FC9E8] font-medium mb-4">Lead Technical Operations Engineer</p>
							<ul class="list-disc list-outside ml-5 space-y-2 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
								<li>Served as primary point person for technical incidents affecting production systems, prioritizing triage by team caseload and business urgency and leading resolution.</li>
								<li>Led root-cause investigations across production systems, coordinating with engineering and business stakeholders to drive fixes.</li>
								<li>Wrote technical documentation and SOPs that translated complex technical issues for non-technical stakeholders.</li>
							</ul>
						</div>

						<!-- Technical Operations Engineer -->
						<div>
							<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
								<h3 class="text-xl font-bold">Solera | AutoPoint · Jacksonville, FL</h3>
								<span class="text-sm text-gray-500 dark:text-gray-400 mt-1 sm:mt-0">September 2019 – January 2022</span>
							</div>
							<p class="text-[#8FC9E8] font-medium mb-4">Technical Operations Engineer</p>
							<ul class="list-disc list-outside ml-5 space-y-2 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
								<li>Owned customer-reported technical issues from first contact through root-cause analysis to verified resolution, serving as a front-line point of contact for end users.</li>
								<li>Diagnosed and resolved system issues, escalating appropriately to engineering teams.</li>
								<li>Gathered technical requirements from internal and external stakeholders to inform fixes and improvements.</li>
							</ul>
						</div>
					</div>
				</section>

				<!-- Education -->
				<section class="pt-12 border-t-2 border-gray-200 dark:border-gray-800">
					<h2 class="text-3xl sm:text-4xl font-bold mb-8 tracking-tight">Education & Certifications</h2>
					<div class="space-y-6">
						<div>
							<h3 class="text-xl font-bold">CompTIA A+</h3>
							<p class="text-gray-600 dark:text-gray-400 mt-1">In progress</p>
						</div>
						<div>
							<h3 class="text-xl font-bold">Arizona State University</h3>
							<p class="text-gray-600 dark:text-gray-400 mt-1">B.S., Data Science (in progress, expected 2029)</p>
						</div>
						<div>
							<h3 class="text-xl font-bold">Florida State University</h3>
							<p class="text-gray-600 dark:text-gray-400 mt-1">B.S., Information Communication Technology, 2013</p>
						</div>
					</div>
				</section>
			</div>
		</main>

		<Footer />
		<Analytics />
	</body>
</html>
