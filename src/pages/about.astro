---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Analytics from '@vercel/analytics/astro'
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About Andy | Andy McGuinness | Support Engineer & Developer" description="Learn more about Andy McGuinness: a software support engineer and full-stack developer based in NW Ohio." />
		<script is:inline>
			// Prevent flash of wrong theme
			(function() {
				const getTheme = () => {
					const stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') return stored;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				document.documentElement.classList.add(getTheme());
			})();
		</script>
	</head>
	<body class="bg-white dark:bg-black text-black dark:text-white">
		<Navigation currentPath="/about" />

		<main class="pt-32 pb-20 px-6 sm:px-8 lg:px-12">
			<div class="max-w-4xl mx-auto">
				<!-- Page Header -->
				<div class="mb-20">
					<h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tighter mb-6">
						About
					</h1>
					<div class="w-24 h-1 bg-[#E8B4B8] mb-12"></div>
					<p class="text-2xl sm:text-3xl md:text-4xl font-light text-gray-600 dark:text-gray-400 leading-relaxed max-w-3xl">
						Multi-hyphenate dude living in NW Ohio.
					</p>
				</div>

				<!-- Content -->
				<div class="space-y-8 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
					<p>
						Heya, I'm Andy! I'm a software support engineer and full-stack developer with around a decade total of experience. I have done everything from being on the front lines of retail as a supervisor to being a Senior Software Engineer. I also spent 4 years as a software support engineer, diagnosing software issues and providing excellent customer support.
					</p>

					<p>
						I currently run <a href="https://codebyandy.com" target="_blank" rel="noopener noreferrer" class="font-medium text-black dark:text-white border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors">Code by Andy</a>, my freelance practice where I've been helping startups and small businesses go 0→1 since 2015. I hold a BS in Information Communication Technology from Florida State University.
					</p>

					<p>
						I live in NW Ohio with my lovely partner and our 6 (yes, six) cats. Outside of work, you'll find me playing Dungeons & Dragons or logging hours in World of Warcraft.
					</p>
				</div>

				<!-- Connect Section -->
				<div class="mt-20 pt-12 border-t-2 border-gray-200 dark:border-gray-800">
					<h2 class="text-3xl sm:text-4xl font-bold mb-8 tracking-tight">
						Say Hello
					</h2>

					<p class="text-lg text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
						Want to work together or just say hi? You can <a href="/contact" class="font-medium text-black dark:text-white border-b-2 border-[#E8B4B8] hover:border-[#D4A0A5] transition-colors">send me a message</a> or find me at:
					</p>

					<div class="grid sm:grid-cols-2 gap-6">
						<a
							href="https://github.com/andymcguinness"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-center gap-3 p-6 border border-gray-200 dark:border-gray-800 hover:border-[#E8B4B8] dark:hover:border-[#E8B4B8] transition-colors"
						>
							<div class="text-lg font-medium">GitHub</div>
							<div class="ml-auto text-sm text-gray-500 dark:text-gray-400">@andymcguinness</div>
						</a>

						<a
							href="https://linkedin.com/in/mcguinnessandy"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-center gap-3 p-6 border border-gray-200 dark:border-gray-800 hover:border-[#E8B4B8] dark:hover:border-[#E8B4B8] transition-colors"
						>
							<div class="text-lg font-medium">LinkedIn</div>
							<div class="ml-auto text-sm text-gray-500 dark:text-gray-400">@mcguinnessandy</div>
						</a>
					</div>
				</div>
			</div>
		</main>

		<Footer />
		<Analytics />
	</body>
</html>
