---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import Analytics from '@vercel/analytics/astro'
import "../styles/global.css";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title=`Contact | ${SITE_TITLE}` description="Get in touch with Andy McGuinness for projects, info, or to just generally say hi." />
		<script is:inline>
			// Prevent flash of wrong theme
			(function() {
				const getTheme = () => {
					const stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') return stored;
					return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				};
				document.documentElement.classList.add(getTheme());
			})();
		</script>
	</head>
	<body class="bg-white dark:bg-black text-black dark:text-white">
		<Navigation currentPath="/contact" />

		<main class="pt-32 pb-20 px-6 sm:px-8 lg:px-12">
			<div class="max-w-2xl mx-auto">
				<!-- Page Header -->
				<div class="mb-20">
					<h1 class="text-5xl sm:text-6xl md:text-7xl font-black tracking-tighter mb-6">
						Get in Touch
					</h1>
					<div class="w-24 h-1 bg-[#E8B4B8] mb-12"></div>
					<p class="text-xl sm:text-2xl font-light text-gray-600 dark:text-gray-400 leading-relaxed">
						Have a project in mind or just want to chat? Fill out the form below and I'll get back to you as soon as possible.
					</p>
				</div>

				<!-- Contact Form -->
				<form
					id="contact-form"
					action="https://formspree.io/f/nxnrqzwx"
					method="POST"
					class="space-y-8"
				>
					<!-- Name field -->
					<div>
						<label for="name" class="block text-sm font-bold mb-3 uppercase tracking-wider text-gray-700 dark:text-gray-300">
							Name <span class="text-[#E8B4B8]">*</span>
						</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							class="w-full px-0 py-3 border-b-2 border-gray-200 dark:border-gray-800 bg-transparent text-lg focus:outline-none focus:border-[#E8B4B8] transition-colors placeholder-gray-400 dark:placeholder-gray-600"
							placeholder="Your name"
						/>
					</div>

					<!-- Email field -->
					<div>
						<label for="email" class="block text-sm font-bold mb-3 uppercase tracking-wider text-gray-700 dark:text-gray-300">
							Email <span class="text-[#E8B4B8]">*</span>
						</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							class="w-full px-0 py-3 border-b-2 border-gray-200 dark:border-gray-800 bg-transparent text-lg focus:outline-none focus:border-[#E8B4B8] transition-colors placeholder-gray-400 dark:placeholder-gray-600"
							placeholder="your.email@example.com"
						/>
					</div>

					<!-- Subject field -->
					<div>
						<label for="subject" class="block text-sm font-bold mb-3 uppercase tracking-wider text-gray-700 dark:text-gray-300">
							Subject
						</label>
						<input
							type="text"
							id="subject"
							name="subject"
							class="w-full px-0 py-3 border-b-2 border-gray-200 dark:border-gray-800 bg-transparent text-lg focus:outline-none focus:border-[#E8B4B8] transition-colors placeholder-gray-400 dark:placeholder-gray-600"
							placeholder="What's this about?"
						/>
					</div>

					<!-- Message field -->
					<div>
						<label for="message" class="block text-sm font-bold mb-3 uppercase tracking-wider text-gray-700 dark:text-gray-300">
							Message <span class="text-[#E8B4B8]">*</span>
						</label>
						<textarea
							id="message"
							name="message"
							required
							rows="6"
							class="w-full px-0 py-3 border-b-2 border-gray-200 dark:border-gray-800 bg-transparent text-lg focus:outline-none focus:border-[#E8B4B8] transition-colors resize-none placeholder-gray-400 dark:placeholder-gray-600"
							placeholder="Your message here..."
						></textarea>
					</div>

					<!-- FormSpree honeypot (spam protection) -->
					<input type="text" name="_gotcha" style="display:none" />

					<!-- Submit button -->
					<div class="pt-4">
						<button
							type="submit"
							id="submit-btn"
							class="px-12 py-4 bg-black dark:bg-white text-white dark:text-black font-bold text-lg hover:bg-gray-800 dark:hover:bg-gray-200 focus:outline-none focus:ring-4 focus:ring-[#E8B4B8]/50 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
						>
							Send Message
						</button>
					</div>

					<!-- Status messages -->
					<div id="form-status" class="hidden mt-6 p-6 border-2"></div>
				</form>

				<!-- Alternative contact methods -->
				<div class="mt-20 pt-12 border-t-2 border-gray-200 dark:border-gray-800">
					<h2 class="text-3xl sm:text-4xl font-bold mb-8 tracking-tight">
						Other Ways to Connect
					</h2>

					<div class="grid sm:grid-cols-2 gap-6">
						<a
							href="https://github.com/andymcguinness"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-center gap-3 p-6 border border-gray-200 dark:border-gray-800 hover:border-[#E8B4B8] dark:hover:border-[#E8B4B8] transition-colors"
						>
							<div class="text-lg font-medium">GitHub</div>
							<div class="ml-auto text-sm text-gray-500 dark:text-gray-400">@andymcguinness</div>
						</a>

						<a
							href="https://linkedin.com/in/mcguinnessandy"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-center gap-3 p-6 border border-gray-200 dark:border-gray-800 hover:border-[#E8B4B8] dark:hover:border-[#E8B4B8] transition-colors"
						>
							<div class="text-lg font-medium">LinkedIn</div>
							<div class="ml-auto text-sm text-gray-500 dark:text-gray-400">@mcguinnessandy</div>
						</a>

						<a
							href="https://instagram.com/andymcgnnss"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-center gap-3 p-6 border border-gray-200 dark:border-gray-800 hover:border-[#E8B4B8] dark:hover:border-[#E8B4B8] transition-colors"
						>
							<div class="text-lg font-medium">Instagram</div>
							<div class="ml-auto text-sm text-gray-500 dark:text-gray-400">@andymcgnnss</div>
						</a>

						<a
							href="https://instagram.com/codebyandy"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex items-center gap-3 p-6 border border-gray-200 dark:border-gray-800 hover:border-[#E8B4B8] dark:hover:border-[#E8B4B8] transition-colors"
						>
							<div class="text-lg font-medium">Code by Andy</div>
							<div class="ml-auto text-sm text-gray-500 dark:text-gray-400">@codebyandy</div>
						</a>
					</div>
				</div>
			</div>
		</main>

		<Footer />
		<Analytics />

		<script>
			// Client-side form handling
			const form = document.getElementById('contact-form') as HTMLFormElement;
			const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
			const formStatus = document.getElementById('form-status') as HTMLElement;

			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				// Disable submit button
				submitBtn.disabled = true;
				submitBtn.textContent = 'Sending...';

				// Hide previous status messages
				formStatus.classList.add('hidden');

				try {
					const formData = new FormData(form);
					const response = await fetch(form.action, {
						method: 'POST',
						body: formData,
						headers: {
							'Accept': 'application/json'
						}
					});

					if (response.ok) {
						// Success
						formStatus.classList.remove('hidden');
						formStatus.classList.add('border-[#E8B4B8]', 'bg-[#F5E5E7]', 'dark:bg-[#E8B4B8]/10', 'text-black', 'dark:text-white');
						formStatus.classList.remove('border-gray-800', 'bg-gray-100', 'dark:bg-gray-900');
						formStatus.textContent = 'Thanks for reaching out! I\'ll get back to you soon.';
						form.reset();
					} else {
						// Error
						const data = await response.json();
						throw new Error(data.error || 'Something went wrong');
					}
				} catch (error) {
					// Error handling
					formStatus.classList.remove('hidden');
					formStatus.classList.add('border-gray-800', 'bg-gray-100', 'dark:bg-gray-900', 'text-black', 'dark:text-white');
					formStatus.classList.remove('border-[#E8B4B8]', 'bg-[#F5E5E7]', 'dark:bg-[#E8B4B8]/10');
					formStatus.textContent = error instanceof Error ? error.message : 'Oops! Something went wrong. Please try again.';
				} finally {
					// Re-enable submit button
					submitBtn.disabled = false;
					submitBtn.textContent = 'Send Message';
				}
			});
		</script>
	</body>
</html>
